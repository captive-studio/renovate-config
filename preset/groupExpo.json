{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "groupName": "Expo & React Native core",
      "matchManagers": ["npm"],
      "addLabels": ["warning"],
      "prBodyNotes": [
        "ATTENTION : verifier que Expo Go est bien disponible pour la version du SDK Expo mise a jour avant de merger cette PR."
      ],
      "matchPackagePatterns": [
        "^(@expo|expo)($|[-/])",
        "^(@react|react)($|[-/])",
        "@sentry/react-native",
        "@types/react",
        "babel-preset-expo",
        "jest"
      ],
      "ignoreDeps": [
        "@react-native-community/datetimepicker",
        "@react-native-picker/picker",
        "@sentry/react-native",
        "@types/jest",
        "@types/react",
        "jest",
        "react",
        "react-dom",
        "react-native-screens",
        "react-native-svg",
        "react-native-webview"
      ]
    }
  ]
}
