{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Automerge Trusted packages",
  "packageRules": [
    {
      "matchUpdateTypes": ["major", "minor", "patch"],
      "matchSourceUrls": [
        "https://github.com/captive-studio/es-project-config"
      ],
      "automerge": true
    },
    {
      "description": "Automerge des packages de confiance, y compris en majeure",
      "matchManagers": ["npm"],
      "automerge": true,
      "matchPackageNames": [
        "lint-staged",
        "uuid",
        "@forge/api",
        "@forge/bridge",
        "@forge/react",
        "@forge/resolver",
        "@forge/cli",
        "eslint-config-expo",
        "@testing-library/react-native",
        "typescript",
        "jsdom"
      ]
    },
    {
      "description": "Automerge des packages de confiance, sauf en majeure",
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true,
      "matchPackageNames": [
        "core-js",
        "date-fns",
        "esbuild",
        "ionicons",
        "pinia",
        "sass",
        "vue",
        "cypress",
        "vue-router",
        "tailwindcss",
        "@ionic/lab",
        "@vue/test-utils",
        "lucide-react-native",
        "react-hook-form",
        "@tanstack/react-query",
        "@uiw/react-signature",
        "libphonenumber-js",
        "lodash",
        "lucide-react-native",
        "openai",
        "qs",
        "crypto-js",
        "date-fns",
        "sweetalert2",
        "jwt-decode",
        "written-number",
        "zod",
        "jest",
        "json-stringify-pretty-compact",
        "react-syntax-highlighter",
        "react-select",
        "@lottiefiles/dotlottie-react",
        "swiper",
        "@forge/react",
        "axios",
        "pdfjs-dist",
        "@lucide/lab",
        "@vueuse/core"
      ]
    },
    {
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true,
      "matchPackagePrefixes": [
        "@capacitor/",
        "@sentry/",
        "@rails/",
        "@hotwired/"
      ]
    },
    {
      "matchUpdateTypes": ["patch"],
      "matchPackageNames": ["axios", "express", "typescript"],
      "automerge": true
    },
    {
      "matchUpdateTypes": ["patch"],
      "automerge": true,
      "matchManagers": ["npm"]
    },
    {
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "description": "Automerge chromium-edge-launcher en major pour 1.x → 2.x uniquement",
      "matchManagers": ["npm"],
      "matchPackageNames": ["chromium-edge-launcher"],
      "matchCurrentVersion": "/^1\\./",
      "allowedVersions": ">=2.0.0 <3.0.0",
      "automerge": true
    },
    {
      "description": "Automerge pinia en major pour 3.x → 4.x uniquement",
      "matchManagers": ["npm"],
      "matchPackageNames": ["pinia"],
      "matchCurrentVersion": "/^3\\./",
      "allowedVersions": ">=4.0.0 <5.0.0",
      "automerge": true
    },
    {
      "description": "Automerge @fullcalendar/core en major pour 6.x → 7.x uniquement",
      "matchManagers": ["npm"],
      "matchPackageNames": ["@fullcalendar/core"],
      "matchCurrentVersion": "/^6\\./",
      "allowedVersions": ">=7.0.0 <8.0.0",
      "automerge": true
    }
  ]
}
