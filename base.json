{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Default base configuration for all Captive projects.",
  "dependencyDashboard": true,
  "extends": [
    "github>w5s/renovate-config:_base",
    "github>captive-studio/renovate-config//preset/commit",
    "github>captive-studio/renovate-config//preset/schedule",
    "github>captive-studio/renovate-config//preset/automergeBase",
    "github>captive-studio/renovate-config//preset/minimumReleaseAge",
    "github>captive-studio/renovate-config//preset/digest",
    ":separateMultipleMajorReleases",
    ":separateMultipleMinorReleases",
    ":pinAllExceptPeerDependencies",
    "workarounds:all",
    "github>captive-studio/renovate-config//preset/ghcr",
    "github>captive-studio/renovate-config//preset/pinDigest"
  ],
  "onboarding": false,
  "internalChecksAsSuccess": true,
  "transitiveRemediation": true,
  "postUpdateOptions": ["npmDedupe"],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 0,
  "platformAutomerge": true,
  "updateNotScheduled": true,
  "assigneesFromCodeOwners": false
}
